# Copy to .env and fill in. Never commit .env.

# ---- PayPal (sandbox) ----
# Developer Dashboard > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Sandbox Business account email (landlord / invoicer)
PAYPAL_SANDBOX_MERCHANT_EMAIL=
# Sandbox Personal account email (tenant / invoice recipient)
PAYPAL_SANDBOX_BUYER_EMAIL=
# From the webhook you add for <your URL>/api/webhooks/paypal (Invoice paid, Payouts item events)
PAYPAL_WEBHOOK_ID=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
# AI review and Aunt Tally's chat; empty means claude-opus-5-5. Cheaper: claude-sonnet-5-5, claude-haiku-5-5
REVIEW_MODEL=
ASSISTANT_MODEL=

# ---- Database (Neon Postgres) ----
DATABASE_URL=

# ---- Daily schedule (Vercel Cron sends it as a Bearer token) ----
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ---- Later: email notifications ----
RESEND_API_KEY=
