# ---- PayPal (sandbox) ----
# Developer Dashboard > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Sandbox Business account email (landlord / invoicer)
PAYPAL_SANDBOX_MERCHANT_EMAIL=
# Sandbox Personal account email (tenant / invoice recipient)
PAYPAL_SANDBOX_BUYER_EMAIL=
# Fill in after creating the webhook in the dashboard
PAYPAL_WEBHOOK_ID=

# ---- Later (not needed for the PayPal spike) ----
ANTHROPIC_API_KEY=
DATABASE_URL=
RESEND_API_KEY=
